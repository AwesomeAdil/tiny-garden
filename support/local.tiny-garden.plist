<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tiny Garden as the live wallpaper: starts at login, restarts after a crash,
     stays quit after `tiny-garden quit` (a clean exit). scripts/install fills in __HOME__. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.tiny-garden</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Applications/Tiny Garden.app/Contents/MacOS/tiny-garden</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/.local/state/tiny-garden/log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/tiny-garden/log</string>
</dict>
</plist>
